     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sCalc (chaîne ANSI)  <indiquez ici le rôle de sCalc>
      //! @param taVal (tableau associatif (entier))  )  )  )  )  <indiquez ici le rôle de taVal>
      //!
      //! @return (non typé)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure global Basic(Local sCalc est une chaîne, taVal est un tableau associatif d'entier)
      
      nResult est un entier
      pour tout nVal, sKey DE taVal
      	sCalc = Remplace(sCalc, sKey, (nVal))
      FIN
      
      si compile("MonCalcul", "RENVOYER " + sCalc)="" alors
      	nResult = ExécuteTraitement("MonCalcul", trtProcédure)
      sinon
      	cMess.PushError("Problème pendant la compilation de" + RC + sCalc + RC + ErreurInfo())
      	renvoyer faux
      fin
      
      renvoyer nResult
