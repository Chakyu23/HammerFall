     p_codes :
      -
        code : |1-
         PROCEDURE FI_Caractéristiques()
         vf_nID	est un entier
         vf_oCaract est un cCaracteristique
         
         selon vg_oApp.oUser.eRank
         	cas cUser.eAdmin, cUser.eModerator
         		MaFenêtreInterne..Plan = 1
         
         	cas cUser.eCreateur, cUser.eBot, cUser.ePlayer
         		MaFenêtreInterne..Plan = 2
         fin
         
         GR_EditCaract..Etat	= Grisé
         GR_VisuCaract..Etat	= Actif
      -
        code : |1+
         prc_AffList
         
         
