 code_elements :
  type_code : 71
  p_codes : []
  procedures :
   -
     name : prc_AffCaract
     procedure_id : 1897521263173953527
     type_code : 14
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure prc_AffCaract()
      nInd est un entier
      
      nInd = TableSelect(tbl_Caractéristique)
      si nInd = -1 alors retour
      
      SAI_Tag 	= COL_TAG[nInd]
      SAI_NOM 	= COL_Nom[nInd]
      SAI_Desc 	= COL_Desc[nInd]
      SAI_Calcul 	= COL_CALC[nInd]
      SAI_Min 	= COL_Min[nInd]
      SAI_Max 	= COL_Max[nInd]
      int_Max 	= COL_bMax[nInd]
      int_Mini 	= COL_bMin[nInd]
     type : 458752
   -
     name : prc_AffList
     procedure_id : 1897534667847206719
     type_code : 14
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure prc_AffList()
      nind est un entier
      
      TableSupprimeTout(tbl_Caractéristique)
      pour tout oCaract de cCaracteristique.LstCaract
      	TableAjouteLigne(tbl_Caractéristique,
      	oCaract.nID,
      	oCaract.sTag,
      	oCaract.sName,
      	oCaract.sDesc,
      	oCaract.nMin,
      	oCaract.bMin,
      	oCaract.nMax,
      	oCaract.bMax,
      	oCaract.sCalc
      	)
      	si oCaract.sCalc = "" ALORS
      		COL_bCalc[nind] = Faux
      	sinon
      		COL_bCalc[nind] = Vrai
      	FIN
      
      FIN
     type : 458752
  procedure_templates : []
  property_templates : []
