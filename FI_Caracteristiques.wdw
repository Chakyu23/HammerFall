            nInd est un entier
            
            nInd = TableSelect(tbl_Caractéristique)
            si nInd = -1 alors retour
            
            vf_nID = COL_ID[nInd]
            
            si pas vf_oCaract.CaractSelect(vf_nID) alors retour
            
            prc_AffCaract()
