   -
     name : CaractGetAll
     procedure_id : 1897504714530102043
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure global CaractGetAll()
      rep est un JSON
      nInd est un entier
      
      rep = pglb_CaractGetAll()
      si rep.Code <> 200 alors
      	cMess.PushError(rep.Mess)
      	renvoyer Faux
      fin
      
      quand exception dans
      	pour tout _Caract de rep.data
      		nInd = TableauAjoute(::m_LstCaract)
      		::m_LstCaract[nInd].ChargeCaract(_Caract)
      	fin
      faire
      	cMess.PushError("Structure de caractéristique invalide")
      	renvoyer faux
      fin
      
      renvoyer vrai
     type : 458752
   -
     name : ChargeCaract
     procedure_id : 1897505264292859941
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param rep (JSON)  <indiquez ici le rôle de rep>
      //!
      //!
      
      procédure ChargeCaract(rep est un JSON)
      
      :m_nID 		= rep.IDCaracteristique
      :m_sTag 	= rep.Tag
      :m_sName 	= rep.Name
      :m_nMin 	= rep.Val_Mini
      :m_nMax		= rep.Val_Maxi
      :m_bMin 	= rep.b_Mini
      :m_nMax	 	= rep.b_Maxi
      :m_sCalc	= rep.Calcul
      :m_sDesc 	= rep.Description
     type : 458752
   -
     name : CaractSet
     procedure_id : 1897507158395767064
     type_code : 12
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure CaractSet()
      req		est un JSon
      rep		est un json
      nInd	est un entier
      
      req.Tag						= :m_sTag
      req.Name					= :m_sName
      req.Val_Mini				= :m_nMin
      req.Val_Maxi				= :m_nMax
      req.b_Mini					= :m_bMin
      req.b_Maxi					= :m_nMax
      req.Calcul					= :m_sCalc
      req.Description				= :m_sDesc
      
      rep							= pglb_CaractSet(req)
      si rep.Code <> 200 alors
      	cMess.PushError(rep.Mess)
      	renvoyer Faux
      fin
      
      nInd = TableauAjoute(::m_lstCaract, Objet)
      ::m_LstCaract[nInd].ChargeCaract(rep)
      
      renvoyer Vrai
     type : 458752
   -
     name : CaractUpdate
     procedure_id : 1897507274359911181
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure CaractUpdate()
      nInd	est un entier
      req		est un JSON
      rep		est un Json
      
      req.Name					= :m_sName
      req.Val_Mini				= :m_nMin
      req.Val_Maxi				= :m_nMax
      req.b_Mini					= :m_bMin
      req.b_Maxi					= :m_nMax
      req.Calcul					= :m_sCalc
      req.Description				= :m_sDesc
      
      rep							= pglb_CaractUpdate(:m_nID, req)
      si rep.Code <> 200 alors
      	cMess.PushError(rep.Mess)
      	renvoyer Faux
      fin
      
      nInd = TableauCherche(::m_LstCaract, tcLinéaire, "m_nID", :m_nID)
      si nInd <> -1 alors
      	::m_LstCaract[nInd].ChargeCaract(rep)
      fin
      
      renvoyer Vrai
     type : 458752
   -
     name : CaractSuppr
     procedure_id : 1897509018134668431
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nIdSuppr (entier)  nId (entier)  <indiquez ici le rôle de nId>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure Global CaractSuppr(nIdSuppr est un entier)
      rep		est un json
      nInd	est une chaîne
      
      rep = pglb_CaractSuppr(nIdSuppr)
      si rep.Code <> 200 alors
      	cMess.PushError(rep.Mess)
      	renvoyer Faux
      fin
      
      nInd = TableauCherche(::m_LstCaract, tcLinéaire, "m_nID", nIdSuppr)
      si nInd <> -1 alors
      	TableauSupprime(::m_LstCaract, nInd)
      fin
      
      renvoyer vrai
     type : 458752
   -
     name : CaractSelect
     procedure_id : 1897527821653258986
     type_code : 12
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nIdSelect (entier)  <indiquez ici le rôle de nIdSelect>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure CaractSelect(nIdSelect est un entier)
      nInd est un entier
      
      nInd = TableauCherche(::m_LstCaract, tcLinéaire, "m_nID", nIdSelect)
      si nInd <> -1 alors
      	renvoyer Faux
      fin
      
      Objet = ::m_LstCaract[nInd]
      
      renvoyer Vrai
      
     type : 458752
