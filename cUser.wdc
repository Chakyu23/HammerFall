   -
     name : Connect
     procedure_id : 1895899650816776360
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  s  <indiquez ici le rôle de s>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //!
      
      procédure Connect(sLogin est une chaîne, sMdp est une chaîne)
      rep est un JSON
      
      :priv_Raz()
      
      rep = pglb_AuthentBasic(sLogin, sMdp)
      si rep.Code <> 200 ALORS
      	cMess.PushError(rep.Mess)
      	retour
      FIN
      
      :m_sUUID	= rep.User.ID
      :m_sLogin 	= sLogin
      :m_Token	= rep.User.Token
      
      si pas :priv_ReadRank(rep.User.Rank) ALORS Retour
       
      FEN_HammerFall._Menu..Etat = Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
     type : 458752
   -
     name : Disconnect
     procedure_id : 1895899650816841943
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Disconnect()
      :priv_Raz()
      
      FEN_HammerFall._Menu..Etat = Grisé
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Cnx)
     type : 458752
   -
     name : Register
     procedure_id : 1895899650816973093
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Register(sLogin est une chaîne, sMdp est une chaîne)
      rep est un JSON
      
      :priv_Raz()
      
      rep = pglb_RegisterBasic(sLogin, sMdp)
      SI rep.Code <> 200 ALORS
      	cMess.PushError(rep.Mess)
      	RETOUR
      FIN
      
      :m_sUUID	= rep.User.ID
      :m_sLogin 	= sLogin
      :m_Token	= rep.User.Token
      
      SI PAS :priv_ReadRank(rep.User.Rank) ALORS retour
      
      FEN_HammerFall._Menu..Etat	= Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
     type : 458752
   -
     name : priv_ReadRank
     procedure_id : 1895900677320293952
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param bufRank (buffer)  buffRank (buffer)  sRank (buffer)  <indiquez ici le rôle de sRank>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure privée priv_ReadRank(LOCAL bufRank est un buffer)
      bufKey			est un buffer
      sRankResult	est une chaîne
      
      bufKey			= HashChaîne(HA_HMAC_SHA3_256, :m_sUUID + CC_SELMDP)
      sRankResult	= deCrypteStandard(bufRank, bufKey, crypteAES256)
      
      si pâs EnumérationVérifieValeur(eRanks, sRankResult) ALORS
      	cMess.PushError("Compte en erreur contacter le support")
      	RENVOYER Faux
      FIN
      :m_eRank = EnumérationDepuisValeur(eRanks, sRankResult)
      
      renvoyer vrai
     type : 458752
   -
     name : priv_Raz
     procedure_id : 1896249209625737661
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      
      procédure privée priv_Raz()
      :m_sUUID	= ""
      :m_sLogin	= ""
      :m_Token	= ""
      :m_eRank	= ePlayer
     type : 458752
   -
     name : TitreCompte
     procedure_id : 1896255862550634480
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (chaîne ANSI)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure TitreCompte()
      sTitre est une chaîne
      
      sTitre = "Bienvenue "
      
      SELON :m_eRank
      	CAS eAdmin
      		sTitre += "administrateur "
      
      	CAS eModerator
      		sTitre += "modérateur "
      
      	cas eCreateur
      		sTitre += "createur "
      
      	CAS eBot
      		sTitre += "supervision du bot "
      
      	autre cas
      FIN
      sTitre += :m_sLogin
      
      renvoyer sTitre
     type : 458752
