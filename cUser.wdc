   -
     name : Connect
     procedure_id : 1895899650816776360
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  s  <indiquez ici le rôle de s>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //!
      
      procédure Connect(sLogin est une chaîne, sMdp est une chaîne)
      rep est un JSON
      
      :priv_Raz()
      
      rep = pglb_AuthentBasic(sLogin, sMdp)
      si rep.Code <> 200 ALORS
      	cMess.PushError(rep.Mess)
      	retour
      FIN
      
      :m_sUUID	= rep.User.ID
      :m_sLogin 	= sLogin
      :m_Token	= rep.User.Token
      si pas EnumérationVérifieValeur(cUser::eRanks, rep.User.Rank) alors
      	cMess.PushError("Veuillez contacter le support (Rang invalide)")
      fin
      :m_eRank	= EnumérationDepuisValeur(cUser::eRanks, rep.User.Rank)
      
      FEN_HammerFall.GR_MENU..Etat = Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
     type : 458752
   -
     name : Disconnect
     procedure_id : 1895899650816841943
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Disconnect()
      :priv_Raz()
      
      FEN_HammerFall.GR_MENU..Etat = Grisé
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Cnx)
     type : 458752
   -
     name : Register
     procedure_id : 1895899650816973093
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Register(sLogin est une chaîne, sMdp est une chaîne)
      rep est un JSON
      
      si sLogin = "" _ou_ sMdp = "" alors
      	cMess.PushError("Veuillez saisir un login et un mot de passe")
      	retour
      FIN
      
      :priv_Raz()
      
      rep = pglb_RegisterBasic(sLogin, sMdp)
      SI rep.Code <> 200 ALORS
      	cMess.PushError(rep.Mess)
      	RETOUR
      FIN
      
      :m_sUUID	= rep.User.ID
      :m_sLogin 	= sLogin
      :m_Token	= rep.User.Token
      si pas EnumérationVérifieValeur(cUser::eRanks, rep.User.Rank) ALORS
      	cMess.PushError("Veuillez contacter le support (Rang invalide)")
      FIN
      :m_eRank	= EnumérationDepuisValeur(cUser::eRanks, rep.User.Rank)
      
      FEN_HammerFall.GR_MENU..Etat	= Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
     type : 458752
   -
     name : priv_Raz
     procedure_id : 1896249209625737661
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      
      procédure privée priv_Raz()
      :m_sUUID	= ""
      :m_sLogin	= ""
      :m_Token	= ""
      :m_eRank	= ePlayer
     type : 458752
   -
     name : TitreCompte
     procedure_id : 1896255862550634480
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (chaîne ANSI)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure TitreCompte()
      sTitre est une chaîne
      
      sTitre = "Bienvenue "
      
      SELON :m_eRank
      	CAS eAdmin
      		sTitre += "administrateur "
      
      	CAS eModerator
      		sTitre += "modérateur "
      
      	cas eCreateur
      		sTitre += "createur "
      
      	CAS eBot
      		sTitre += "supervision du bot "
      
      	autre cas
      FIN
      sTitre += :m_sLogin
      
      renvoyer sTitre
     type : 458752
