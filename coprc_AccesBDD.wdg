 code_elements :
  type_code : 31
  p_codes :
   -
     code : |1-
      vcc_sRep est une chaîne
      
      CONSTANTE
      	CC_PASSETEMP	= "93cea0da06abcb9bf2b9c2ab3af0f9d4"
      	CC_SELMDP		= "c0a82a1450f482ac521ec78c174d5eaf5c94ed8ba2041d725ee6cbaddafd042d"
      FIN
      
      vcc_sRep = "D:\Data"
      
      si pas fRepExiste(vcc_sRep) ALORS
      	si pas fRepCrée(vcc_sRep) ALORS
      		cMess.PushCriticalError("Impossible de créé le répertoire de BDD")
      		FinProgramme()
      	FIN
      FIN
      
      HPasse("*", CC_PASSETEMP)
      HChangeRep("*", vcc_sRep)
      HCréationSiInexistant("*", CC_PASSETEMP)
     type : 720896
  procedures :
   -
     name : pglb_AuthentBasic
     procedure_id : 1895851427015771823
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  <indiquez ici le rôle de sLogin>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_AuthentBasic(sLogin est une chaîne, sMdp est une chaîne)
      Rep			est un JSON
      BufMdp		est un buffer
      bufToken	est un buffer
      
      BufMdp = Majuscule(BufferVersHexa(HashChaîne(HA_PBKDF2_HMAC_SHA_256, sMdp, CC_SELMDP, 256, 256), SansRegroupement))
      
      si pas HLitRecherche(Users, LoginPassword, [sLogin, BufMdp], hIdentique) ALORS
      	renvoyer Err(404, "Le login n'existe pas")
      FIN
      
      Rep.Code		= 200
      Rep.User.ID		= Users.IDUsers
      Rep.User.Rank	= Users.Rank
      
      // Gestion Token
      bufToken =  priv_GenToken()
      si bufToken = 0 ALORS
      	Rep.Code	= 502
      	Rep.Mess	= "Le serveur n'est pas disponible"
      	RENVOYER Rep
      FIN
      
      Rep.User.Token		= bufToken
      
      renvoyer Rep
     type : 458752
   -
     name : pglb_RegisterBasic
     procedure_id : 1895852170054855334
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  <indiquez ici le rôle de sLogin>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_RegisterBasic(sLogin est une chaîne, sMdp est une chaîne)
      Rep			est un JSON
      BufMdp		est un Buffer
      bufToken	est un buffer
      
      BufMdp = Majuscule(BufferVersHexa(HashChaîne(HA_PBKDF2_HMAC_SHA_256, sMdp, CC_SELMDP, 256, 256), SansRegroupement))
      si HLitRecherche(Users, Login, sLogin, hIdentique) ALORS
      	RENVOYER Err(409, "Le login existe déjà")
      fin
      
      HRAZ(Users)
      Users.Login		= sLogin
      Users.Password	= BufMdp
      si pas HAjoute(Users) ALORS
      	RENVOYER Err(502, "Le serveur n'est pas disponible")
      FIN
      
      Users.Rank	= cUser::ePlayer..Valeur
      
      SI PAS HModifie(Users) ALORS
      	RENVOYER Err(502, "Le serveur n'est pas disponible")
      FIN
      
      Rep.Code			= 200
      Rep.User.ID			= Users.IDUsers
      Rep.User.Rank		= Users.Rank
      
      // Gestion token
      bufToken		=  priv_GenToken()
      SI bufToken = 0 ALORS
      	RENVOYER Err(502, "Le serveur n'est pas disponible")
      FIN
      
      Rep.User.Token		= bufToken
      
      renvoyer Rep
     type : 458752
   -
     name : pglb_ChangeRank
     procedure_id : 1895856885969890777
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sUUID (UUID sur 128 bits)  sEncodedUUID (chaîne ANSI)  (chaîne ANSI)  <indiquez ici le rôle de sUUID>
      //! @param eRank (cUser.eRanks)  <indiquez ici le rôle de eRank>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_ChangeRank(sUUID est un uuid, eRank est un cuser::eRanks)
      Rep		est un JSON
      
      SI PAS HLitRecherche(Users, IDUsers, sUUID, hIdentique) ALORS
      	RENVOYER Err(404, "Le login n'existe pas")
      FIN
      
      users.Rank = eRank..Valeur
      
      SI PAS HModifie(Users) ALORS
      	RENVOYER Err(502, "Le serveur n'est pas disponible")
      FIN
      
      Rep.Code = 200
      
      RENVOYER Rep
     type : 458752
   -
     name : priv_GenToken
     procedure_id : 1895869771006439710
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (entier)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure privé priv_GenToken()
      
      SI pas HLitRecherche(Token, IDUsers, Users.IDUsers, hIdentique) ALORS
      	si HErreur() <> 0 alors RENVOYER Faux
      
      	Token.IDUsers = Users.IDUsers
      	SI PAS HAjoute(Token) ALORS
      		RENVOYER Faux
      	FIN
      FIN
      
      Token.DateToken = DateSys()
      si pas HModifie(Token) ALORS
      	renvoyer faux
      FIN
      
      RENVOYER Token.IDToken
     type : 458752
   -
     name : priv_ReadToken
     procedure_id : 1895869809661219989
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nUUID (UUID sur 256 bits)  nUID (UUID sur 256 bits)  <indiquez ici le rôle de nUID>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure Privée priv_ReadToken(nUUID est un UUID sur 256)
      dDateLimit est une date
      
      si pas HLitRecherche(Token, IDToken, nUUID, hIdentique) ALORS
      	renvoyer faux
      FIN
      
      dDateLimit = DateSys()
      dDateLimit..Jour -= 31
      si Token.DateToken < dDateLimit ALORS
      	renvoyer faux
      FIN
      
      renvoyer vrai
     type : 458752
   -
     name : pglb_CaractGetAll
     procedure_id : 1897501390197378526
     type_code : 15
     group : 1
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_CaractGetAll()
      Rep est un JSON
      
      req_Caract est une requête SQL =
      `
      	SELECT * FROM Caracteristique<§cs:3§>
      `
      
      si pas HExécuteRequête(req_Caract,hRequêteDéfaut) ALORS
      	renvoyer err(502, "Le serveur n'est pas disponible")
      fin
      
      Rep.Code = 200
      Rep.Data = req_Caract.EnregistrementVersJSON()
      
      renvoyer Rep
     type : 458752
   -
     name : pglb_CaractSet
     procedure_id : 1897502038737590972
     type_code : 15
     group : 1
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param Request (JSON)  <indiquez ici le rôle de Request>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_CaractSet(Request est un JSON)
      rep est un Json
      
      HRAZ(Caracteristique)
      
      Caracteristique.Name					= Request.Name
      Caracteristique.Val_Mini				= Request.Val_Mini
      Caracteristique.Val_Maxi				= Request.Val_Maxi
      Caracteristique.b_Mini					= Request.b_Mini
      Caracteristique.b_Maxi					= Request.b_Maxi
      Caracteristique.Calcul					= Request.Calcul
      Caracteristique.Description				= Request.Description
      
      si pas HAjoute(Caracteristique, hVérifieDoublon) ALORS
      	si HErreurDoublon() = vrai ALORS
      		renvoyer Err(409, "Ce tag existe déjà")
      	FIN
      	renvoyer Err(502, "Le serveur n'est pas disponible")
      FIN
      
      rep			= Caracteristique.EnregistrementVersJSON()
      rep.Code	= 200
      
      renvoyer rep
     type : 458752
   -
     name : pglb_CaractUpdate
     procedure_id : 1897502090277275466
     type_code : 15
     group : 1
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nId (entier)  <indiquez ici le rôle de nId>
      //! @param Request (JSON)  Rep (JSON)  <indiquez ici le rôle de Rep>
      //!
      //!
      
      procédure pglb_CaractUpdate(nId est un entier, Request est un JSON)
      rep est un JSON
      
      si pas HLitRecherche(Caracteristique,IDCaracteristique, nId, hIdentique) ALORS
      	renvoyer Err(404, "La caractéristique n'existe pas")
      FIN
      
      Caracteristique.Name					= Request.Name
      Caracteristique.Val_Mini				= Request.Val_Mini
      Caracteristique.Val_Maxi				= Request.Val_Maxi
      Caracteristique.b_Mini					= Request.b_Mini
      Caracteristique.b_Maxi					= Request.b_Maxi
      Caracteristique.Calcul					= Request.Calcul
      Caracteristique.Description				= Request.Description
      
      si pas HModifie(Caracteristique) ALORS
      	renvoyer Err(502, "Le serveur n'est pas disponible")
      FIN
      
      rep			= Caracteristique.EnregistrementVersJSON()
      rep.Code	= 200
      
      renvoyer rep
     type : 458752
   -
     name : pglb_CaractSuppr
     procedure_id : 1897502137521992321
     type_code : 15
     group : 1
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nId (entier)  <indiquez ici le rôle de nId>
      //!
      //!
      
      procédure pglb_CaractSuppr(nId est un entier)
      rep est un JSON
      
      si pas HLitRecherche(Caracteristique,IDCaracteristique, nId, hIdentique) alors
      	renvoyer Err(404, "La caractéristique n'existe pas")
      fin
      
      si pas HSupprime(Caracteristique) ALORS
      	renvoyer Err(502, "Le serveur n'est pas disponible")
      FIN
      
      rep.Code = 200
      renvoyer rep
     type : 458752
   -
     name : Err
     procedure_id : 1897511290197604775
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param nCode (entier)  <indiquez ici le rôle de nCode>
      //! @param sMess (chaîne ANSI)  <indiquez ici le rôle de sMess>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure Err(nCode est un entier, sMess est une chaîne)
      rep est un JSON
      
      rep.Code = nCode
      rep.nMess = sMess
      
      renvoyer rep
     type : 458752
