  type_code : 31
  p_codes :
   -
     code : |1-
      vcc_sRep est une chaîne
      
      CONSTANTE
      	CC_PASSETEMP	= "93cea0da06abcb9bf2b9c2ab3af0f9d4"
      	CC_SELMDP		= "c0a82a1450f482ac521ec78c174d5eaf5c94ed8ba2041d725ee6cbaddafd042d"
      FIN
      
      vcc_sRep = fRepExe() + [fSep()] + "Data"
      
      si pas fRepExiste(vcc_sRep) ALORS
      	si pas fRepCrée(vcc_sRep) ALORS
      		cMess.PushCriticalError("Impossible de créé le répertoire de BDD")
      		FinProgramme()
      	FIN
      FIN
      
      HPasse("*", CC_PASSETEMP)
      HChangeRep("*", vcc_sRep)
      HCréationSiInexistant("*", CC_PASSETEMP)
     type : 720896
  procedures :
   -
     name : pglb_AuthentBasic
     procedure_id : 1895851427015771823
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  <indiquez ici le rôle de sLogin>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_AuthentBasic(sLogin est une chaîne, sMdp est une chaîne)
      Rep			est un JSON
      BufMdp		est un buffer
      bufToken	est un buffer
      
      BufMdp = Majuscule(BufferVersHexa(HashChaîne(HA_PBKDF2_HMAC_SHA_256, sMdp, CC_SELMDP, 256, 256), SansRegroupement))
      
      si pas HLitRecherche(Users, LoginPassword, [sLogin, BufMdp], hIdentique) ALORS
      	si HErreur() = 0 ALORS
      		Rep.Code	= 502
      		Rep.Mess	= "Le serveur n'est pas disponible"
      	SINON
      		Rep.Code	= 404
      		Rep.Mess	= "Le login n'existe pas"
      	FIN
      	RENVOYER Rep
      FIN
      
      Rep.Code		= 200
      Rep.User.ID		= Users.IDUsers
      Rep.User.Rank	= Users.Rank
      
      
      Rep.Token		=
      renvoyer Rep
     type : 458752
   -
     name : pglb_RegisterBasic
     procedure_id : 1895852170054855334
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  <indiquez ici le rôle de sLogin>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_RegisterBasic(sLogin est une chaîne, sMdp est une chaîne)
      Rep		est un JSON
      BufMdp	est un Buffer
      bufRank	est un Buffer
      bufKey	est un Buffer
      
      BufMdp = Majuscule(BufferVersHexa(HashChaîne(HA_PBKDF2_HMAC_SHA_256, sMdp, CC_SELMDP, 256, 256), SansRegroupement))
      si HLitRecherche(Users, Login, sLogin, hIdentique) ALORS
      	Rep.Code	= 404
      	Rep.Mess	= "Le login existe déjà"
      	RENVOYER Rep
      SINON
      	SI HErreur() = 0 ALORS
      		Rep.Code	= 502
      		Rep.Mess	= "Le serveur n'est pas disponible"
      		RENVOYER Rep
      	FIN
      fin
      
      HRAZ(Users)
      Users.Login		= sLogin
      Users.Password	= BufMdp
      si pas HAjoute(Users) ALORS
      	Rep.Code	= 502
      	Rep.Mess	= "Le serveur n'est pas disponible"
      	RENVOYER Rep
      FIN
      
      bufRank = cUser::ePlayer..Valeur
      bufKey	= Users.IDUsers + CC_SELMDP
      Users.Rank = CrypteStandard(bufRank, bufKey, crypteAES256)
      
      SI PAS HModifie(Users) ALORS
      	Rep.Code	= 502
      	Rep.Mess	= "Le serveur n'est pas disponible"
      	RENVOYER Rep
      FIN
      
      Rep.Code		= 200
      Rep.User.ID		= Users.IDUsers
      Rep.User.Rank	= Users.Rank
      
      renvoyer Rep
     type : 458752
   -
     name : pglb_ChangeRank
     procedure_id : 1895856885969890777
     type_code : 15
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sUUID (chaîne ANSI)  sEncodedUUID (chaîne ANSI)  (chaîne ANSI)  <indiquez ici le rôle de sUUID>
      //! @param eRank (cUser.eRanks)  <indiquez ici le rôle de eRank>
      //!
      //! @return (JSON)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure pglb_ChangeRank(sUUID est une chaîne, eRank est un cuser::eRanks)
      Rep		est un JSON
      bufRank	est un Buffer
      bufKey	est un Buffer
      
      SI PAS HLitRecherche(Users, IDUsers, sUUID, hIdentique) ALORS
      	SI HErreur() = 0 ALORS
      		Rep.Code	= 502
      		Rep.Mess	= "Le serveur n'est pas disponible"
      	SINON
      		Rep.Code	= 404
      		Rep.Mess	= "Le login n'existe pas"
      	FIN
      	RENVOYER Rep
      FIN
      
      bufRank		= eRank..Valeur
      bufKey		= sUUID + CC_SELMDP
      Users.Rank	= CrypteStandard(bufRank, bufKey, crypteAES256)
      
      SI PAS HModifie(Users) ALORS
      	Rep.Code	= 502
      	Rep.Mess	= "Le serveur n'est pas disponible"
      	RENVOYER Rep
      FIN
      
      RENVOYER Rep
     type : 458752
