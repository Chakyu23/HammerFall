     type_code : 12
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //!
      procédure Register(sLogin est une chaîne, sMdp est une chaîne)
      VariableRAZ(:m_oUser)
      
      SI PAS pglb_RegisterBasic(sLogin, sMdp) ALORS
      	cMess.PushError("Échec de l'enregistrement")
      FIN
      
      FEN_HammerFall._Menu..Etat	= Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
