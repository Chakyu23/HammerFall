   -
     name : Connect
     internal_properties : IQAAACAAAAADlc+TLXgu3ISKMeb6PY2Fh7WkeY05ZOt8Y7H6xJ8j+pGemDnbaP3C8K+cSLOcNxgAwS7qccc0advlMkk//KVvdp7N4UqHZ+o5v+f2wHsFUffmJ8g44YwHUhGdHFUEcg==
     procedure_id : 1895523119791466508
     type_code : 12
     code : |1-
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param sLogin (chaîne ANSI)  s  <indiquez ici le rôle de s>
      //! @param sMdp (chaîne ANSI)  <indiquez ici le rôle de sMdp>
      //!
      //!
      
      procédure Connect(sLogin est une chaîne, sMdp est une chaîne)
      rep est un JSON
      VariableRAZ(:m_oUser)
      
      rep = pglb_AuthentBasic(sLogin, sMdp)
      si rep.Code <> 200 ALORS
      	cMess.PushError(rep.Mess)
      	retour
      FIN
      
      
      
      FEN_HammerFall._Menu..Etat = Actif
      ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
     type : 458752
