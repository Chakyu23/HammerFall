     name : SelectMenu
     procedure_id : 1895509066513251411
     type_code : 12
     code : |1+
      //!
      //! @brief <indiquez ici ce que fait la procédure>
      //!
      //! @param eOption (cMenu.eOptions)  sNomOption (chaîne ANSI)  Nom logique de l'option clic
      //!
      //! @return (booléen)  <indiquez ici les valeurs possibles ainsi que leur interprétation>
      //!
      //!
      
      procédure SelectMenu(eOption est une eOptions)
      
      si eOption = :m_eOptionActive ALORS renvoyer Faux
      
      selon eOption
      	// Global
      	CAS eGlobal
      		ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Global)
      
      	// SousMenu
      	CAS eCaracteristique
      		ChangeFenêtreSource(FEN_HammerFall.CFI_Main, FI_Caracteristiques)
      
      FIN
      
      :m_eOptionActive = eOption
      
      renvoyer vrai
      
      
